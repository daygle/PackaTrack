<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Decorative circles in background -->
    <path
        android:fillColor="#6366F1"
        android:fillAlpha="0.05"
        android:pathData="M100,100m-80,0a80,80 0,1 1,160 0a80,80 0,1 1,-160 0" />
    <path
        android:fillColor="#0EA5E9"
        android:fillAlpha="0.03"
        android:pathData="M100,100m-60,0a60,60 0,1 1,120 0a60,60 0,1 1,-120 0" />

    <!-- Isometric Hero Box (Larger) -->
    <!-- Shadow -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.1"
        android:pathData="M100,160 L140,140 L100,125 L60,140 Z" />

    <!-- Left Face (Emerald) -->
    <path
        android:fillColor="#10B981"
        android:pathData="M100,100 L60,80 L60,140 L100,160 Z" />

    <!-- Right Face (Sky) -->
    <path
        android:fillColor="#0EA5E9"
        android:pathData="M100,100 L140,80 L140,140 L100,160 Z" />

    <!-- Top Face (Indigo) -->
    <path
        android:fillColor="#6366F1"
        android:pathData="M100,100 L140,80 L100,60 L60,80 Z" />

    <!-- Detail: Tracking Line floating around -->
    <path
        android:pathData="M40,100 C40,60 80,40 120,50"
        android:strokeWidth="3"
        android:strokeColor="#10B981"
        android:strokeLineCap="round"
        android:strokeAlpha="0.6" />
    <path
        android:pathData="M160,120 C160,150 120,170 80,160"
        android:strokeWidth="2"
        android:strokeColor="#6366F1"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4" />

    <!-- A small "plus" icon indicating "Add" -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M95,85 L105,85 L105,75 L95,75 Z M95,85 L95,95 L105,95 L105,85 Z" />
        <!-- Wait, simple cross -->
    <path
        android:pathData="M90,80 L110,80 M100,70 L100,90"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

</vector>
